# GradeBoost environment configuration
# NOTE: This app switched from NVIDIA NIM to OpenRouter.
# If you previously used NVIDIA_API_KEY / NVIDIA_MODEL, replace them with the vars below.

# OpenRouter API key (free key from https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# Default models (optional)
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Optional: custom OpenRouter-compatible endpoint
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: cap response length
# OPENROUTER_CHAT_MAX_TOKENS=512
# OPENROUTER_VISION_MAX_TOKENS=1024
